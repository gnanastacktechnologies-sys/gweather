# ============================================================================
# G-WEATHER Village Edition — Environment Template (MERN Architecture)
# ============================================================================
# DO NOT commit real passwords, secret keys, or database URIs to source control.
# Copy this file to `.env` locally when setting up Stage 3 & Stage 4.

# Backend Server Port
PORT=5000

# Node Environment (development / production)
NODE_ENV=development

# MongoDB Connection String (Stage 4)
# Example local: mongodb://localhost:27017/gweather
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/gweather?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/gweather

# API Authentication / Ingestion Key (For ESP32 -> Express API data security in Stage 3)
API_SECRET_KEY=your_secure_random_api_key_here

# React Frontend URL (For CORS configuration)
CLIENT_URL=http://localhost:3000
